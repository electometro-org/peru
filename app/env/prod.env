# Non-secret build settings for the production deploy.
# deploy-app.yml appends this file to the .env decoded from the APP_ENV_FILE secret, so keys here
# override the same keys in the secret. Only public values belong here (they end up in the page).
VITE_RYBBIT_ENABLED=true
VITE_RYBBIT_HOST=https://pulse.decide.pe
VITE_RYBBIT_SITE_ID=e945667695b5
