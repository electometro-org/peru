# Tolgee configuration (only needed for development/in-context editing)
VITE_TOLGEE_API_URL=https://app.tolgee.io
VITE_TOLGEE_API_KEY=your-api-key-here

# i18n translations URL
VITE_I18N_URL=

# Electometro app URL
VITE_ELECTOMETRO_URL=

# Assets base URL (R2 bucket for party logos, etc.)
VITE_ASSETS_BASE_URL=

# Rybbit (self-hosted analytics). HOST is the instance origin (or your proxy), without a trailing
# slash; it must also be whitelisted in public/_headers (script-src + connect-src). The homepage
# reports to the same Rybbit SITE_ID as the electometro app (tagged data-tag="home").
VITE_RYBBIT_ENABLED=true
VITE_RYBBIT_HOST=https://pulse.decide.pe
VITE_RYBBIT_SITE_ID=