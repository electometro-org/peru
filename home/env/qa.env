# Non-secret build settings for the QA homepage deploy (appended to .env after HOMEPAGE_ENV_FILE).
# Analytics stays off on QA until it has its own Rybbit site: create one, put its id below and set
# VITE_RYBBIT_ENABLED=true, so test traffic never mixes with production data.
VITE_RYBBIT_ENABLED=false
VITE_RYBBIT_HOST=https://pulse.decide.pe
VITE_RYBBIT_SITE_ID=
